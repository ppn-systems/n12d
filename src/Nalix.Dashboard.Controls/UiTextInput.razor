<input id="@Id"
       class="ui-input @(Monospace ? "ui-mono" : null) @Class"
       type="@Type"
       value="@Value"
       placeholder="@Placeholder"
       disabled="@Disabled"
       autocomplete="@AutoComplete"
       @oninput="OnInput" />

@code {
    /// <summary>Gets or sets the element id.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Gets or sets the text value.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Gets or sets the callback invoked on every input.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Gets or sets the input type attribute.</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Gets or sets the placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Gets or sets a value that renders the text in the monospace font.</summary>
    [Parameter] public bool Monospace { get; set; }

    /// <summary>Gets or sets a value that disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets the autocomplete attribute.</summary>
    [Parameter] public string? AutoComplete { get; set; }

    /// <summary>Gets or sets extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    private Task OnInput(ChangeEventArgs args)
    {
        return ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }
}
