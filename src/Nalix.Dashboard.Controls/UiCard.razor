<section class="ui-card @Class">
    @if (Title is not null || Subtitle is not null || Actions is not null)
    {
        <header class="ui-card-head">
            <div class="ui-card-titles">
                @if (Title is not null)
                {
                    <h3 class="ui-card-title">@Title</h3>
                }
                @if (Subtitle is not null)
                {
                    <p class="ui-card-subtitle">@Subtitle</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="ui-card-actions">@Actions</div>
            }
        </header>
    }
    <div class="ui-card-body">@ChildContent</div>
</section>

@code {
    /// <summary>Gets or sets the heading.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Gets or sets the muted line under the heading.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Gets or sets controls rendered at the top right of the card.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Gets or sets the card body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }
}
