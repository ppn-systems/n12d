        "settings" => "<circle cx='12' cy='12' r='3'/><path d='M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1'/>",
        "log" => "<path d='M6 3h8l4 4v14H6z'/><path d='M9 12h6M9 16h6M9 8h2'/>",
        "play" => "<path d='M7 5l12 7-12 7z'/>",
        "pause" => "<path d='M8 5v14M16 5v14'/>",
        "stop" => "<rect x='6' y='6' width='12' height='12' rx='1.5'/>",
        "record" => "<circle cx='12' cy='12' r='7'/><circle cx='12' cy='12' r='2.5'/>",
        "download" => "<path d='M12 4v11M7 10l5 5 5-5M5 20h14'/>",
        "plug" => "<path d='M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0V8zM12 16v5'/>",
        "unplug" => "<path d='M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0V8z'/><path d='M3 3l18 18'/>",
        "sun" => "<circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/>",
        "moon" => "<path d='M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z'/>",
        "menu" => "<path d='M4 7h16M4 12h16M4 17h16'/>",
        "chevron-right" => "<path d='M9 6l6 6-6 6'/>",
        "chevron-down" => "<path d='M6 9l6 6 6-6'/>",
        "alert" => "<path d='M12 4l9 16H3z'/><path d='M12 10v4M12 17.5v.01'/>",
        "check" => "<path d='M5 12.5l4.5 4.5L19 7.5'/>",
        "close" => "<path d='M6 6l12 12M18 6L6 18'/>",
        "refresh" => "<path d='M20 11a8 8 0 1 0-2.3 5.7'/><path d='M20 4v7h-7'/>",
        _ => "<circle cx='12' cy='12' r='4'/>",
    };
}
