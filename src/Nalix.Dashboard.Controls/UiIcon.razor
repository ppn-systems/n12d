<svg class="ui-icon @Class"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">@((MarkupString)_paths)</svg>

@code {
    private string _paths = string.Empty;

    /// <summary>Gets or sets the icon name, for example <c>overview</c> or <c>chevron-down</c>. Unknown names render a dot.</summary>
    [EditorRequired]
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>Gets or sets the width and height in pixels.</summary>
    [Parameter] public int Size { get; set; } = 18;

    /// <summary>Gets or sets extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _paths = PathsFor(Name);
    }

    private static string PathsFor(string name) => name switch
    {
        "overview" => "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/>",
        "process" => "<rect x='6' y='6' width='12' height='12' rx='2'/><path d='M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4'/>",
        "dispatch" => "<path d='M4 7h11M4 12h16M4 17h11'/><path d='M12 4l3 3-3 3M12 14l3 3-3 3'/>",
        "connections" => "<circle cx='6' cy='6' r='2.5'/><circle cx='18' cy='6' r='2.5'/><circle cx='12' cy='18' r='2.5'/><path d='M8.2 7.2l2.6 8.6M15.8 7.2l-2.6 8.6M8.5 6h7'/>",
        "sessions" => "<circle cx='12' cy='8' r='4'/><path d='M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6'/>",
        "tasks" => "<path d='M9 6h11M9 12h11M9 18h11'/><path d='M4 6l1.5 1.5L8 5M4 12l1.5 1.5L8 11M4 18l1.5 1.5L8 17'/>",
        "buffers" => "<ellipse cx='12' cy='6' rx='8' ry='3'/><path d='M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6'/>",
        "object-pools" => "<path d='M12 3l8 4-8 4-8-4 8-4z'/><path d='M4 7v10l8 4 8-4V7M12 11v10'/>",
        "listeners" => "<circle cx='12' cy='12' r='2'/><path d='M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8'/>",
        "protocols" => "<path d='M7 8l-4 4 4 4M17 8l4 4-4 4M14 4l-4 16'/>",
        "connection-guard" => "<path d='M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6l8-3z'/><path d='M9 12l2 2 4-4'/>",
        "concurrency-gate" => "<path d='M4 20V8l8-4 8 4v12'/><path d='M9 20v-6h6v6'/>",
        "policy-rate-limiter" => "<path d='M4 16a8 8 0 1 1 16 0'/><path d='M12 16l4-5'/><circle cx='12' cy='16' r='1.2'/>",
        "token-bucket-limiter" => "<path d='M5 8h14l-1.5 12h-11L5 8z'/><path d='M9 8a3 3 0 0 1 6 0'/>",
        "instances" => "<rect x='4' y='3' width='16' height='7' rx='1.5'/><rect x='4' y='14' width='16' height='7' rx='1.5'/><path d='M8 6.5h.01M8 17.5h.01'/>",
        "diagnostics" => "<path d='M3 12h4l2-5 4 10 2-5h6'/>",
