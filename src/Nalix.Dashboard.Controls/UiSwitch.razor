<button type="button"
        role="switch"
        class="ui-switch @Class"
        aria-checked="@(Value ? "true" : "false")"
        aria-label="@Label"
        disabled="@Disabled"
        @onclick="Toggle">
    <span class="ui-switch-track" aria-hidden="true">
        <span class="ui-switch-knob"></span>
    </span>
    @if (Label is not null)
    {
        <span class="ui-switch-label">@Label</span>
    }
</button>

@code {
    /// <summary>Gets or sets the on/off state.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Gets or sets the callback invoked with the new state.</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Gets or sets the visible and accessible label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Gets or sets a value that disables the switch.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    private Task Toggle()
    {
        return ValueChanged.InvokeAsync(!Value);
    }
}
