<input id="@Id"
       class="ui-input ui-input--number @Class"
       type="number"
       value="@Value"
       min="@Min"
       max="@Max"
       step="@Step"
       disabled="@Disabled"
       @onchange="OnChange" />

@code {
    /// <summary>Gets or sets the element id.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Gets or sets the integer value.</summary>
    [Parameter] public int Value { get; set; }

    /// <summary>Gets or sets the callback invoked with the clamped value when the input commits.</summary>
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    /// <summary>Gets or sets the minimum allowed value; no lower bound when null.</summary>
    [Parameter] public int? Min { get; set; }

    /// <summary>Gets or sets the maximum allowed value; no upper bound when null.</summary>
    [Parameter] public int? Max { get; set; }

    /// <summary>Gets or sets the step attribute.</summary>
    [Parameter] public int Step { get; set; } = 1;

    /// <summary>Gets or sets a value that disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    private Task OnChange(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int next))
        {
            return Task.CompletedTask;
        }

        if (Min is { } low && next < low)
        {
            next = low;
        }

        if (Max is { } high && next > high)
        {
            next = high;
        }

        return ValueChanged.InvokeAsync(next);
    }
}
