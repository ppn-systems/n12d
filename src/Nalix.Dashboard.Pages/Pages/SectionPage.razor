@page "/section/{Slug}"
@inherits StoreComponent

<PageTitle>@(Section?.Title ?? "Not found") · Nalix</PageTitle>

@if (Section is null)
{
    <UiEmpty Title="Unknown section" Message="@($"There is no report called '{Slug}'.")" />
}
else
{
    <div class="ui-stack">
        <div class="ad-page__head">
            <div>
                <h1 class="ad-page__title">@Section.Title</h1>
                <p class="ad-page__hint">@Section.Description</p>
            </div>
            <span class="ui-spacer"></span>
            <UiButton Variant="UiButtonVariant.Secondary" OnClick="ToggleRaw"><UiIcon Name="@(_raw ? "overview" : "log")" /> @(_raw ? "Formatted" : "Raw JSON")</UiButton>
        </div>

        @if (Store.GetSection(Section) is not { } node)
        {
            <UiEmpty Title="No data" Message="@(Store.Latest is null ? "Waiting for the first sample…" : "The server does not register this component, or it has not reported yet.")" />
        }
        else if (_raw)
        {
            <UiCard><pre class="raw ui-mono">@RawJson(node)</pre></UiCard>
        }
        else
        {
            @if (HasHighlightSeries(Section.Key))
            {
                <UiStatGroup>
                    @foreach ((string label, string path, int slot) in SectionHighlights.For(Section.Key))
                    {
                        if (Series(path) is { } series)
                        {
                            <UiStat Slot="@slot" Label="@label" Value="@Show(path)" Series="@series.Values" OnClick="@(() => Open(path))" />
                        }
                    }
                </UiStatGroup>
            }

            @if (IsTruncated(node))
            {
                <div class="sp-banner" role="note">
                    <span class="sp-banner__icon" aria-hidden="true"><UiIcon Name="alert" Size="16" /></span>
                    <span>Long lists were shortened to fit one response. Totals above are exact; open Raw JSON for what was sent.</span>
                </div>
            }

            <UiReportView Node="@node" PathPrefix="@Section.Key" OnMetricClick="Open" />
        }
    </div>
}

@code {
    private bool _raw;

    [Parameter]
    public string? Slug { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private SectionInfo? Section => Sections.FindBySlug(Slug);

    protected override RuntimeObservationTargets WatchedTargets => Section?.Target ?? RuntimeObservationTargets.NONE;

    private void ToggleRaw() => _raw = !_raw;

    private bool HasHighlightSeries(string sectionKey)
    {
        IReadOnlyList<(string Label, string Path, int Slot)> highlights = SectionHighlights.For(sectionKey);
        for (int i = 0; i < highlights.Count; i++)
        {
            if (Series(highlights[i].Path) is not null)
            {
                return true;
            }
        }

        return false;
    }

    private static bool IsTruncated(ReportNode node) => node.Get("_truncated") is { Kind: ReportNodeKind.Boolean, Number: not 0 };

    private void Open(string path) => Navigation.NavigateTo(MetricUrl(path));

    private static string RawJson(ReportNode node)
    {
        System.Text.StringBuilder builder = new();
        ReportText.Write(builder, node, 0);
        return builder.ToString();
    }
}
