@inherits StoreComponent

<span class="nx-pill @Tone" role="status"><span class="nx-pill__dot" aria-hidden="true"></span>@Text</span>

@code {
    private string Tone => Store.Status switch
    {
        ConnectionStatus.Connected when Store.IsPaused => "is-warn",
        ConnectionStatus.Connected => "is-ok",
        ConnectionStatus.Connecting or ConnectionStatus.Authorizing => "is-info is-busy",
        ConnectionStatus.Faulted => "is-danger",
        _ => "is-neutral",
    };

    private string Text => Store.Status switch
    {
        ConnectionStatus.Connected when Store.IsPaused => "Paused",
        ConnectionStatus.Connected => Store.Latest is { } latest ? "Live · " + UiFormat.Duration(latest.RoundTripMs) : "Live",
        ConnectionStatus.Connecting => "Connecting",
        ConnectionStatus.Authorizing => "Authorizing",
        ConnectionStatus.Faulted when Store.IsReconnecting => "Reconnecting",
        ConnectionStatus.Faulted => "Offline",
        _ => "Disconnected",
    };
}
