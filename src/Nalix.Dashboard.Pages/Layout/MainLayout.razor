@inherits LayoutComponentBase
@implements IDisposable
@inject DashboardStore Store
@inject IJSRuntime JS

@if (ShowApp)
{
    <div class="nx-shell">
        <NavRail Collapsed="_railCollapsed" MobileOpen="_navOpen" OnToggleCollapsed="ToggleRail" OnNavigate="CloseNav" />

        <div class="nx-main">
            <header class="nx-topbar">
                <button class="nx-icon-btn nx-hamburger" type="button" title="Menu" aria-label="Navigation"
                        aria-expanded="@(_navOpen ? "true" : "false")" @onclick="ToggleNav">
                    <UiIcon Name="menu" Size="20" />
                </button>
                <StatusPill />
                <span class="nx-endpoint">@Store.Settings.Endpoint</span>
                <span class="nx-spacer"></span>
                @if (Store.Latest is { } latest)
                {
                    <span class="nx-meta" title="Round-trip of the last sample">@UiFormat.Duration(latest.RoundTripMs)</span>
                }
                <button class="nx-icon-btn" type="button" title="@(Store.IsPaused ? "Resume sampling" : "Pause sampling")"
                        aria-label="@(Store.IsPaused ? "Resume sampling" : "Pause sampling")" @onclick="TogglePause">
                    <UiIcon Name="@(Store.IsPaused ? "play" : "pause")" Size="18" />
                </button>
                <button class="nx-icon-btn @(Store.Recorder.IsRecording ? "is-recording" : null)" type="button"
                        title="@(Store.Recorder.IsRecording ? "Stop recording" : "Start recording")"
                        aria-label="@(Store.Recorder.IsRecording ? "Stop recording" : "Start recording")" @onclick="ToggleRecording">
                    <UiIcon Name="@(Store.Recorder.IsRecording ? "stop" : "record")" Size="18" />
                </button>
                <button class="nx-icon-btn" type="button" title="Toggle theme" aria-label="Toggle theme" @onclick="ToggleTheme">
                    <UiIcon Name="@(IsDark ? "sun" : "moon")" Size="18" />
                </button>
                <button class="nx-icon-btn" type="button" title="Disconnect" aria-label="Disconnect" @onclick="Disconnect">
                    <UiIcon Name="unplug" Size="18" />
                </button>
            </header>

            @if (Store.Error is { } error && Store.Status != ConnectionStatus.Connected)
            {
                <div class="nx-banner" role="status">
                    <span class="nx-banner__icon"><UiIcon Name="alert" Size="18" /></span>
                    <span>@error@(Store.IsReconnecting ? " — reconnecting…" : null)</span>
                </div>
            }

            <main class="nx-content">
                @Body
            </main>
        </div>
    </div>
}
else
{
    <ConnectPanel />
}

@code {
    private bool _navOpen;
    private bool _railCollapsed;
    private bool _themeApplied;

    private bool ShowApp => Store.Status == ConnectionStatus.Connected || Store.IsReconnecting;

    private bool IsDark => Store.Settings.Theme == "dark";

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_themeApplied)
        {
            _themeApplied = true;
            await JS.InvokeVoidAsync("n12d.setTheme", Store.Settings.Theme);
        }
    }

    public void Dispose() => Store.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleRail() => _railCollapsed = !_railCollapsed;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    private void TogglePause() => Store.SetPaused(!Store.IsPaused);

    private void ToggleRecording()
    {
        if (Store.Recorder.IsRecording)
        {
            Store.StopRecording();
        }
        else
        {
            Store.StartRecording();
        }
    }

    private async Task ToggleTheme()
    {
        string theme = IsDark ? "light" : "dark";
        await Store.UpdateSettingsAsync(Store.Settings with { Theme = theme });
        await JS.InvokeVoidAsync("n12d.setTheme", theme);
    }

    private Task Disconnect() => Store.DisconnectAsync();
}
