<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Nalix.Dashboard</RootNamespace>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Razor component and DI constructor discovery is not trimmer-analyzable: root our own assemblies
       wholesale and let the trimmer shrink only framework and vendor code. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Nalix.Dashboard" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.Pages" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.Controls" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.State" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.Infrastructure" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.Transport" />
    <TrimmerRootAssembly Include="Nalix.Dashboard.Abstractions" />
    <TrimmerRootAssembly Include="Nalix.Observability.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nalix.Dashboard.Pages\Nalix.Dashboard.Pages.csproj" />
    <ProjectReference Include="..\Nalix.Dashboard.Transport\Nalix.Dashboard.Transport.csproj" />
  </ItemGroup>
</Project>
