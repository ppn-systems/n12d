@namespace Nalix.Dashboard.Components.Pages
@page "/metrics/tasks"
@inherits MetricPageBase

<PageTitle>Tasks — Nalix</PageTitle>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-0" />
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="metrics-page">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="metrics-toolbar" Spacing="2">
        <MudIcon Icon="@Icons.Material.Outlined.Checklist" Class="metric-icon-orange" />
        <MudText Typo="Typo.h5">Tasks</MudText>
        @if (IsStale)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Stale</MudChip>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                       OnClick="ManualRefreshAsync" title="Refresh" />
        <MudIconButton Icon="@(Polling.IsPaused ? Icons.Material.Outlined.PlayArrow : Icons.Material.Outlined.Pause)"
                       Size="Size.Small"
                       OnClick="@(Polling.IsPaused ? Resume : Pause)"
                       title="@(Polling.IsPaused ? "Resume" : "Pause")" />
    </MudStack>

    @{
        var report = Snapshot is null ? null
            : Parsers.Parse<Nalix.Dashboard.Domain.Reports.Tasks.TasksReport>(Target, Snapshot.ObservationData);
    }

    @if (Snapshot is null)
    {
        <MudAlert Severity="Severity.Info">Waiting for data…</MudAlert>
    }
    else if (report is null)
    {
        <MudAlert Severity="Severity.Warning">Could not parse tasks report.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3" Class="mb-4 metrics-grid">
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Workers Running" 
                            Value="@($"{MetricFormat.Count(report.WorkersRunning)} / {MetricFormat.Count(report.WorkersTotal)}")" 
                            Detail="@($"Peak {MetricFormat.Count(report.PeakRunningWorkerCount)}")"
                            ValueColor="@(report.CurrentConcurrencyLimit <= 0 ? Color.Default : ((double)report.WorkersRunning / report.CurrentConcurrencyLimit >= 1.0 ? Color.Error : ((double)report.WorkersRunning / report.CurrentConcurrencyLimit >= 0.9 ? Color.Warning : (report.WorkersRunning == 0 ? Color.Default : Color.Success))))"
                            Hero="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Avg Execution" 
                            Value="@MetricFormat.Milliseconds(report.AverageWorkerExecutionTimeMs)" 
                            Detail="@($"P95 {MetricFormat.Milliseconds(report.P95WorkerExecutionTimeMs)}")"
                            ValueColor="@(report.AverageWorkerExecutionTimeMs > 2000 ? Color.Error : (report.AverageWorkerExecutionTimeMs > 500 ? Color.Warning : Color.Success))"
                            Hero="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Concurrency Limit" 
                            Value="@MetricFormat.Count(report.CurrentConcurrencyLimit)" 
                            Detail="@($"Max workers {MetricFormat.Count(report.MaxWorkers)}")"
                            ValueColor="@(report.CurrentConcurrencyLimit >= report.MaxWorkers ? Color.Warning : Color.Success)"
                            Hero="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Worker Errors"
                            Value="@MetricFormat.Count(report.WorkerErrorCount)"
                            ValueColor="@(report.WorkerErrorCount > 0 ? Color.Error : Color.Success)"
                            Detail="@($"Recurring {MetricFormat.Count(report.RecurringErrorCount)}")"
                            Hero="true" />
            </MudItem>
        </MudGrid>

        @if (report.Memory is { } mem)
        {
            <MudGrid Spacing="2" Class="mb-4 metrics-grid">
                <MudItem xs="12" sm="4">
                    <MetricTile Label="Working Set" Value="@($"{MetricFormat.Number(mem.WorkingSetMB)} MB")" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MetricTile Label="Private Memory" Value="@($"{MetricFormat.Number(mem.PrivateMB)} MB")" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MetricTile Label="Virtual Memory" Value="@($"{MetricFormat.Number(mem.VirtualMB)} MB")" />
                </MudItem>
            </MudGrid>
        }

        @if (report.Process is { } proc)
        {
            <MudGrid Spacing="2" Class="mb-4 metrics-grid">
                <MudItem xs="12" sm="6" md="3">
                    <MetricTile Label="Threads" Value="@MetricFormat.Count(proc.Threads)" Detail="@($"Running {MetricFormat.Count(proc.ThreadsRunning)}")" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MetricTile Label="Completed Work" Value="@MetricFormat.Count(proc.CompletedWorkItems)" Detail="@($"Handles {MetricFormat.Count(proc.Handles)}")" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MetricTile Label="Managed Heap" Value="@($"{MetricFormat.Number(proc.ManagedHeapMB)} MB")" Detail="@($"Uptime {MetricFormat.Number(proc.UptimeDays, 2)} days")" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MetricTile Label="GC Gen 0 / 1 / 2"
                                Value="@($"{MetricFormat.Count(proc.GCGen0)} / {MetricFormat.Count(proc.GCGen1)} / {MetricFormat.Count(proc.GCGen2)}")"
                                Detail="Collections by generation" />
                </MudItem>
            </MudGrid>
        }

        <MudGrid Spacing="2" Class="mb-4 metrics-grid">
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Recurring Tasks" Value="@MetricFormat.Count(report.RecurringCount)" Detail="@($"Runs {MetricFormat.Count(report.RecurringExecutionCount)}")" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Wait Time" 
                            Value="@MetricFormat.Milliseconds(report.AverageWorkerWaitTimeMs)" 
                            Detail="@($"P99 {MetricFormat.Milliseconds(report.P99WorkerExecutionTimeMs)}")"
                            ValueColor="@(report.AverageWorkerWaitTimeMs > 1000 ? Color.Error : (report.AverageWorkerWaitTimeMs > 200 ? Color.Warning : Color.Success))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="CPU Thresholds" Value="@($"{MetricFormat.Number(report.LowCpuThreshold)} / {MetricFormat.Number(report.HighCpuThreshold)}")" Detail="Low / high" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="Adjustment" 
                            Value="@(report.DynamicAdjustmentEnabled ? "Enabled" : "Disabled")" 
                            Detail="@($"{MetricFormat.Seconds(report.ObservingIntervalSeconds)} observe")"
                            ValueColor="@(report.DynamicAdjustmentEnabled ? Color.Success : Color.Default)" />
            </MudItem>
        </MudGrid>

        @if (report.TopRunningWorkers is { Count: > 0 } workers)
        {
            <MetricSection Title="Top Running Workers">
                <MudTable Items="@workers" Dense="true" Hover="true" Striped="false" Class="metric-table metric-table-workers"
                          GroupBy="@_workerGroupDefinition">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh Style="width: 200px;">Id</MudTh>
                        <MudTh Style="width: 220px;">Started</MudTh>
                        <MudTh Style="width: 220px;">Heartbeat</MudTh>
                        <MudTh Style="width: 200px;">Progress</MudTh>
                    </HeaderContent>
                    <GroupHeaderTemplate>
                        @{
                            var groupName = context.Key as string ?? "Unknown";
                            Nalix.Dashboard.Domain.Reports.Tasks.WorkerGroupEntry? groupEntry = null;
                            report?.WorkersByGroup?.TryGetValue(groupName, out groupEntry);
                        }
                        <MudTd Class="mud-table-cell-custom-group" colspan="5">
                            <strong>@(string.IsNullOrWhiteSpace(context.GroupName) ? "Group" : context.GroupName):</strong> @groupName
                            @if (groupEntry is not null)
                            {
                                <span style="font-weight: normal; opacity: 0.85; margin-left: 8px;">
                                    (Running: @groupEntry.Running/@groupEntry.Total@(string.IsNullOrWhiteSpace(groupEntry.Concurrency) || groupEntry.Concurrency == "-" ? "" : $", Concurrency: {groupEntry.Concurrency}"))
                                </span>
                            }
                            else
                            {
                                <span style="font-weight: normal; opacity: 0.85; margin-left: 8px;">
                                    (@context.Items.Count() workers)
                                </span>
                            }
                        </MudTd>
                    </GroupHeaderTemplate>
                    <RowTemplate Context="w">
                        <MudTd Class="metric-table__wide">@(w.Name ?? "-")</MudTd>
                        <MudTd>@(w.Id ?? "-")</MudTd>
                        <MudTd>@MetricFormat.DateTimeOrDash(w.StartedUtc)</MudTd>
                        <MudTd>@MetricFormat.DateTimeOrDash(w.LastHeartbeatUtc)</MudTd>
                        <MudTd>@MetricFormat.Count(w.Progress)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MetricSection>
        }

        @if (report.Recurring is { Count: > 0 } tasks)
        {
            <MetricSection Title="Recurring Tasks">
                <MudTable Items="@tasks" Dense="true" Hover="true" Striped="false" Class="metric-table">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Runs</MudTh>
                        <MudTh>Failures</MudTh>
                        <MudTh>Running</MudTh>
                        <MudTh>Next Run</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="t">
                        <MudTd Class="metric-table__wide">@(t.Name ?? "-")</MudTd>
                        <MudTd>@t.TotalRuns.ToString("N0")</MudTd>
                        <MudTd>
                            <MudText Color="@(t.ConsecutiveFailures > 0 ? Color.Error : Color.Default)">
                                @t.ConsecutiveFailures
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudIcon Icon="@(t.IsRunning ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.PauseCircle)"
                                     Size="Size.Small"
                                     Color="@(t.IsRunning ? Color.Success : Color.Default)" />
                        </MudTd>
                        <MudTd>@MetricFormat.DateTimeOrDash(t.NextRunUtc)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MetricSection>
        }
    }
</MudContainer>

@code {
    protected override RuntimeObservationTarget Target => RuntimeObservationTarget.TASKS;
    protected override string Route => "/metrics/tasks";

    private TableGroupDefinition<Nalix.Dashboard.Domain.Reports.Tasks.RunningWorkerEntry> _workerGroupDefinition = new()
    {
        GroupName = "Group",
        Indentation = true,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.Group ?? "Unknown"
    };
}
