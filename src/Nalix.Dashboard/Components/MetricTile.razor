@namespace Nalix.Dashboard.Components

<MudPaper Class="@Classname" Elevation="1">
    <MudText Typo="@LabelTypo" Class="metric-tile__label">@Label</MudText>
    <MudText Typo="@ValueTypo" Color="@ValueColor" Class="metric-tile__value">@Value</MudText>
    @if (!string.IsNullOrWhiteSpace(Detail))
    {
        <MudText Typo="Typo.caption" Class="metric-tile__detail">@Detail</MudText>
    }
    else if (ChildContent is not null)
    {
        <div class="metric-tile__detail">
            @ChildContent
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Detail { get; set; }
    [Parameter] public Color ValueColor { get; set; } = Color.Default;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Hero { get; set; } = false;

    private string Classname => Hero ? "metric-tile metric-tile--hero" : "metric-tile metric-tile--compact";
    private Typo LabelTypo => Hero ? Typo.subtitle2 : Typo.caption;
    private Typo ValueTypo => Hero ? Typo.h5 : Typo.subtitle1;
}
