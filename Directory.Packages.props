<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The whole dependency surface: the Blazor WebAssembly runtime and the first-party Nalix SDK.
       UI controls, charts, styling and statistics are written in this repository. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Nalix.SDK" Version="14.3.8" />
  </ItemGroup>
</Project>
